# ==============================================================================
# Verified Course Material Studio - Environment Configuration
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Frontend Dev Server
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
FALLBACK_OLLAMA_MODEL=phi3:latest

# Sandboxed Execution Settings
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_OUTPUT_LIMIT_BYTES=65536
DOCKER_SANDBOX_NETWORK=internal_sandbox_net

# Database Configuration
DATABASE_URL=sqlite:///studio.db
